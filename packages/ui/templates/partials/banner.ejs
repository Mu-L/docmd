<%# ---------------------------------------------------------------
  # docmd : the zero-config documentation engine.
  # Multi-position announcement banner.
  #
  # Supported positions:
  #   - 'top': Above/below topbar (text only, images disallowed)
  #   - 'sidebar-top': Top of the navigation sidebar
  #   - 'sidebar-bottom': Bottom of the navigation sidebar
  #   - 'toc-top': Top of table of contents rail
  #   - 'toc-bottom': Bottom of table of contents rail
  # ---------------------------------------------------------------
%>
<%
  const _targetPos = typeof position !== 'undefined' ? position : 'top';
  const _b = (typeof banner !== 'undefined' && banner) 
    ? banner 
    : ((typeof config !== 'undefined' && config.layout && (config.layout.banners?.[_targetPos] || (_targetPos === 'top' ? config.layout.banner : null))) || null);
%>
<% if (_b && (_b.content || _b.html || _b.image || (_b.link && _b.link.url))) { %>
<%
  const _bPos = _b.position || _targetPos || 'top';
  const _bType = _b.type || 'info';
  const _bDismissible = _b.dismissible !== false;
  const _bIcon = _b.icon || null;
  const _bLink = _b.link || null;
  const _hasImage = Boolean(_bPos !== 'top' && _b.image);

  function _resolveUrl(url) {
    if (!url) return '';
    if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//') || url.startsWith('mailto:')) return url;
    if (url.startsWith('/')) return relativePathToRoot + url.substring(1);
    return relativePathToRoot + url;
  }

  const _bLinkUrl = _bLink && _bLink.url ? _resolveUrl(_bLink.url) : null;
  const _bImageUrl = _hasImage ? _resolveUrl(_b.image) : null;
  const _isExternal = Boolean(_bLink && _bLink.url && (_bLink.url.startsWith('http://') || _bLink.url.startsWith('https://')));

  // Lightweight inline-MD: bold and code pass-through
  let _bInner = _b.html || _b.content || '';
  if (!_b.html) {
    _bInner = String(_bInner)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>');
  }
%>
<% if (_bPos === 'top') { %>
<div
  class="docmd-banner docmd-banner--<%= _bType %> docmd-banner--pos-top<%= _bDismissible ? ' is-dismissible' : '' %>"
  data-docmd-banner="top"
  role="status"
  aria-live="polite"
>
  <div class="docmd-banner__inner">
    <% if (_bIcon) { %>
      <span class="docmd-banner__icon" aria-hidden="true">
        <%- renderIcon(_bIcon) %>
      </span>
    <% } %>
    <div class="docmd-banner__content">
      <% if (_bLinkUrl && (!_bLink.text || _bLink.text.trim() === '')) { %>
        <a class="docmd-banner__text-link" href="<%= _bLinkUrl %>" <%= _isExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
          <span class="docmd-banner__text"><%- _bInner %></span>
        </a>
      <% } else { %>
        <span class="docmd-banner__text"><%- _bInner %></span>
        <% if (_bLinkUrl) { %>
          <a class="docmd-banner__link" href="<%= _bLinkUrl %>" <%= _isExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
            <%- _bLink.text || (typeof t === 'function' ? t('readMore') : 'Read more') %>
            <%- renderIcon('arrow-right', { class: 'docmd-banner__link-icon' }) %>
          </a>
        <% } %>
      <% } %>
    </div>
    <% if (_bDismissible) { %>
      <button type="button" class="docmd-banner__close" data-docmd-banner-dismiss aria-label="<%= typeof t === 'function' ? t('close') : 'Close' %>">
        <%- renderIcon('x') %>
      </button>
    <% } %>
  </div>
</div>
<% } else { %>
<div
  class="docmd-banner docmd-banner--card docmd-banner--<%= _bType %> docmd-banner--pos-<%= _bPos %><%= _bDismissible ? ' is-dismissible' : '' %>"
  data-docmd-banner="<%= _bPos %>"
  role="status"
  aria-live="polite"
>
  <div class="docmd-banner__card">
    <% if (_bDismissible) { %>
      <button type="button" class="docmd-banner__close" data-docmd-banner-dismiss aria-label="<%= typeof t === 'function' ? t('close') : 'Close' %>">
        <%- renderIcon('x') %>
      </button>
    <% } %>
    <% if (_bImageUrl) { %>
      <% if (_bLinkUrl) { %>
        <a class="docmd-banner__image-link" href="<%= _bLinkUrl %>" <%= _isExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
          <img src="<%= _bImageUrl %>" alt="<%= _b.alt || '' %>" class="docmd-banner__image" loading="lazy">
        </a>
      <% } else { %>
        <img src="<%= _bImageUrl %>" alt="<%= _b.alt || '' %>" class="docmd-banner__image" loading="lazy">
      <% } %>
    <% } %>
    <% if (_bInner) { %>
      <div class="docmd-banner__content">
        <% if (_bIcon && !_hasImage) { %>
          <span class="docmd-banner__icon" aria-hidden="true">
            <%- renderIcon(_bIcon) %>
          </span>
        <% } %>
        <% if (_bLinkUrl) { %>
          <a class="docmd-banner__text-link" href="<%= _bLinkUrl %>" <%= _isExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
            <span class="docmd-banner__text"><%- _bInner %></span>
          </a>
        <% } else { %>
          <span class="docmd-banner__text"><%- _bInner %></span>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
<% } %>
<% } %>